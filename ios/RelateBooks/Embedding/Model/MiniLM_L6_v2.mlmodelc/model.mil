            tensor<fp16, [1, 1]> var_524_cast_fp16 = reduce_sum(axes = var_524_axes_0, keep_dims = var_524_keep_dims_0, x = mask_cast_fp16)[name = tensor<string, []>("op_524_cast_fp16")];
            tensor<fp16, []> var_525_to_fp16 = const()[name = tensor<string, []>("op_525_to_fp16"), val = tensor<fp16, []>(0x1p+0)];
            tensor<fp16, []> const_19_to_fp16 = const()[name = tensor<string, []>("const_19_to_fp16"), val = tensor<fp16, []>(inf)];
            tensor<fp16, [1, 1]> clip_0_cast_fp16 = clip(alpha = var_525_to_fp16, beta = const_19_to_fp16, x = var_524_cast_fp16)[name = tensor<string, []>("clip_0_cast_fp16")];
            tensor<fp16, [1, 384]> mean_cast_fp16 = real_div(x = summed_cast_fp16, y = clip_0_cast_fp16)[name = tensor<string, []>("mean_cast_fp16")];
            tensor<fp16, [1, 384]> var_529_cast_fp16 = mul(x = mean_cast_fp16, y = mean_cast_fp16)[name = tensor<string, []>("op_529_cast_fp16")];
            tensor<int32, [1]> var_534_axes_0 = const()[name = tensor<string, []>("op_534_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<bool, []> var_534_keep_dims_0 = const()[name = tensor<string, []>("op_534_keep_dims_0"), val = tensor<bool, []>(true)];
            tensor<fp16, [1, 1]> var_534_cast_fp16 = reduce_sum(axes = var_534_axes_0, keep_dims = var_534_keep_dims_0, x = var_529_cast_fp16)[name = tensor<string, []>("op_534_cast_fp16")];
            tensor<fp16, [1, 1]> var_535_cast_fp16 = sqrt(x = var_534_cast_fp16)[name = tensor<string, []>("op_535_cast_fp16")];
            tensor<fp16, []> var_536_to_fp16 = const()[name = tensor<string, []>("op_536_to_fp16"), val = tensor<fp16, []>(0x1.1p-20)];
            tensor<fp16, []> const_20_to_fp16 = const()[name = tensor<string, []>("const_20_to_fp16"), val = tensor<fp16, []>(inf)];
            tensor<fp16, [1, 1]> clip_1_cast_fp16 = clip(alpha = var_536_to_fp16, beta = const_20_to_fp16, x = var_535_cast_fp16)[name = tensor<string, []>("clip_1_cast_fp16")];
            tensor<fp16, [1, 384]> var_539_cast_fp16 = real_div(x = mean_cast_fp16, y = clip_1_cast_fp16)[name = tensor<string, []>("op_539_cast_fp16")];
            tensor<string, []> var_539_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("op_539_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<fp32, [1, 384]> embedding = cast(dtype = var_539_cast_fp16_to_fp32_dtype_0, x = var_539_cast_fp16)[name = tensor<string, []>("cast_44")];
        } -> (embedding);
}